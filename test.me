<!-- Client-Side Modal & Dropdown Interaction Logic -->
<script>
    (function() {
      // Edit Profile Modal Logic
      const openBtn = document.getElementById('openEditModalBtn');
      const closeBtn = document.getElementById('closeEditModalBtn');
      const cancelBtn = document.getElementById('cancelEditModalBtn');
      const saveBtn = document.getElementById('saveEditModalBtn');
      const modal = document.getElementById('editProfileModal');
      const card = document.getElementById('modalCard');

      function openModal() {
        if (!modal) return;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
        if (card) {
          card.classList.remove('scale-95');
          card.classList.add('scale-100');
        }
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.add('opacity-0', 'pointer-events-none');
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        if (card) {
          card.classList.remove('scale-100');
          card.classList.add('scale-95');
        }
        document.body.style.overflow = '';
      }

      if (openBtn) openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (saveBtn) {
        saveBtn.addEventListener('click', function() {
          closeModal();
        });
      }

      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) {
            closeModal();
          }
        });
      }

      // Facebook-Style Profile Avatar Dropdown Logic
      const avatarTrigger = document.getElementById('avatarDropdownTrigger');
      const fbDropdown = document.getElementById('fbProfileDropdown');
      const dropdownWrapper = document.getElementById('avatarDropdownWrapper');

      function toggleAvatarDropdown(e) {
        if (e) e.stopPropagation();
        if (!fbDropdown) return;
        const isOpen = fbDropdown.classList.contains('opacity-100');
        if (isOpen) {
          closeAvatarDropdown();
        } else {
          openAvatarDropdown();
        }
      }

      function openAvatarDropdown() {
        if (!fbDropdown) return;
        fbDropdown.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
        fbDropdown.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
        if (avatarTrigger) {
          avatarTrigger.setAttribute('aria-expanded', 'true');
        }
      }

      function closeAvatarDropdown() {
        if (!fbDropdown) return;
        fbDropdown.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
        fbDropdown.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
        if (avatarTrigger) {
          avatarTrigger.setAttribute('aria-expanded', 'false');
        }
      }

      if (avatarTrigger) {
        avatarTrigger.addEventListener('click', toggleAvatarDropdown);
      }

      // Close pop-ups when clicking outside
      document.addEventListener('click', function(e) {
        if (dropdownWrapper && !dropdownWrapper.contains(e.target)) {
          closeAvatarDropdown();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          if (modal && modal.classList.contains('opacity-100')) {
            closeModal();
          }
          if (fbDropdown && fbDropdown.classList.contains('opacity-100')) {
            closeAvatarDropdown();
          }
        }
      });
    })();
  </script>
